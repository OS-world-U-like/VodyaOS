/* Token kinds.  */
#ifndef YYTOKENTYPE
# define YYTOKENTYPE
  enum yytokentype
  {
    YYEMPTY = -2,
    YYEOF = 0,                     /* "end of file"  */
    YYerror = 256,                 /* error  */
    YYUNDEF = 257,                 /* "invalid token"  */
    CONTIG = 258,                  /* CONTIG  */
    QTEXT = 259,                   /* QTEXT  */
    SPACE = 260,                   /* SPACE  */
    THIN = 261,                    /* THIN  */
    TAB = 262,                     /* TAB  */
    MATRIX = 263,                  /* MATRIX  */
    LCOL = 264,                    /* LCOL  */
    CCOL = 265,                    /* CCOL  */
    RCOL = 266,                    /* RCOL  */
    COL = 267,                     /* COL  */
    MARK = 268,                    /* MARK  */
    LINEUP = 269,                  /* LINEUP  */
    SUM = 270,                     /* SUM  */
    INT = 271,                     /* INT  */
    PROD = 272,                    /* PROD  */
    UNION = 273,                   /* UNION  */
    INTER = 274,                   /* INTER  */
    LPILE = 275,                   /* LPILE  */
    PILE = 276,                    /* PILE  */
    CPILE = 277,                   /* CPILE  */
    RPILE = 278,                   /* RPILE  */
    ABOVE = 279,                   /* ABOVE  */
    DEFINE = 280,                  /* DEFINE  */
    TDEFINE = 281,                 /* TDEFINE  */
    NDEFINE = 282,                 /* NDEFINE  */
    DELIM = 283,                   /* DELIM  */
    GSIZE = 284,                   /* GSIZE  */
    GFONT = 285,                   /* GFONT  */
    INCLUDE = 286,                 /* INCLUDE  */
    FROM = 287,                    /* FROM  */
    TO = 288,                      /* TO  */
    OVER = 289,                    /* OVER  */
    SQRT = 290,                    /* SQRT  */
    SUP = 291,                     /* SUP  */
    SUB = 292,                     /* SUB  */
    SIZE = 293,                    /* SIZE  */
    FONT = 294,                    /* FONT  */
    ROMAN = 295,                   /* ROMAN  */
    ITALIC = 296,                  /* ITALIC  */
    BOLD = 297,                    /* BOLD  */
    FAT = 298,                     /* FAT  */
    UP = 299,                      /* UP  */
    DOWN = 300,                    /* DOWN  */
    BACK = 301,                    /* BACK  */
    FWD = 302,                     /* FWD  */
    LEFT = 303,                    /* LEFT  */
    RIGHT = 304,                   /* RIGHT  */
    DOT = 305,                     /* DOT  */
    DOTDOT = 306,                  /* DOTDOT  */
    HAT = 307,                     /* HAT  */
    TILDE = 308,                   /* TILDE  */
    BAR = 309,                     /* BAR  */
    UNDER = 310,                   /* UNDER  */
    VEC = 311,                     /* VEC  */
    DYAD = 312                     /* DYAD  */
  };
  typedef enum yytokentype yytoken_kind_t;
#endif
